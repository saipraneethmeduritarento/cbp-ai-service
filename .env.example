LOG_LEVEL="INFO"
ENVIRONMENT="local"                        # local | staging | production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>"

# ── LLM provider (src/services/llm/) ───────────────────────────────────────────
# "gemini" (default, native google-genai) | "langchain" (generic multi-provider adapter,
# requires the `langchain` extra — see pyproject.toml)
LLM_PROVIDER=gemini
LLM_EMBEDDING_PROVIDER=gemini

# Optional: redirect model names before they reach the provider. Needed because a few call
# sites pass a hardcoded Gemini model literal instead of reading a setting, so they cannot
# follow LLM_PROVIDER on their own. Values may carry a LangChain "provider:model" prefix.
# Leave unset for no redirection (default) — behaviour is then identical to having no map.
#
# To actually run on another vendor, set LLM_PROVIDER=langchain, install that provider's
# extra (e.g. `uv sync --extra langchain --extra openai`), set its API key below, and map
# every model this app asks for:
#   LLM_MODEL_MAP={"gemini-2.5-pro":"openai:gpt-5","gemini-3.1-pro-preview":"openai:gpt-5","gemini-3.5-flash":"openai:gpt-5-mini","gemini-embedding-2":"openai:text-embedding-3-large"}
# LLM_MODEL_MAP=

# Only needed when routing to that vendor via LLM_MODEL_MAP.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Langfuse LLM tracing (src/core/tracing.py) ────────────────────────────────
# Off by default. Tracing needs LANGFUSE_ENABLED=true AND both keys; with anything less no
# tracing wrapper is installed and the `langfuse` SDK is never even imported, so behaviour is
# identical to not having it. Points at a self-hosted Langfuse instance via LANGFUSE_HOST;
# leaving the host empty falls back to the SDK default (Langfuse Cloud).
LANGFUSE_ENABLED=false
LANGFUSE_HOST="<https://langfuse.your-domain.org>"
LANGFUSE_PUBLIC_KEY="<pk-lf-...>"
LANGFUSE_SECRET_KEY="<sk-lf-...>"
# LANGFUSE_SAMPLE_RATE=1.0            # fraction of traces exported (1.0 = all)
# LANGFUSE_MAX_PAYLOAD_CHARS=20000    # per-field cap on traced prompt/response text
# LANGFUSE_TRACE_EMBEDDINGS=true      # trace embedding calls too (vectors are never sent)
# LANGFUSE_DEBUG=false

# ── Google / Gemini ───────────────────────────────────────────────────────────
GOOGLE_PROJECT_ID="<gcp-project-id>"
GOOGLE_PROJECT_LOCATION="us-central1"
GOOGLE_PROJECT_LOCATION_GLOBAL="global"
GOOGLE_APPLICATION_CREDENTIALS=".creds/<service-account>.json"
GOOGLE_API_KEY="<gemini-api-key>"
GOOGLE_EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_OUTPUT_DIMENSIONALITY=1536
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_PRO_MODEL_NAME=""
GEMINI_FLASH_MODEL_NAME=""

# ── Gemini API client retry ─────────────────────────────────────────────────────
GEMINI_RETRY_INITIAL_DELAY=1.0
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_EXP_BASE=2.0

# ── Designation embeddings (see DesignationMatcherService) ─────────────────────
# 768 must match both the designation_embeddings.embedding pgvector column and the width
# scripts/ingest_designation_embeddings.py writes (it embeds with GOOGLE_EMBEDDING_MODEL at
# output_dimensionality=768, using the same "task: sentence similarity | query:" prefix the
# matcher uses). Changing it requires re-ingesting the table.
DESIGNATION_EMBED_BATCH_SIZE=100
DESIGNATION_EMBEDDING_DIMENSIONS=768

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_DESIG_EMB_PREFIX="cbp_desig_emb"

# ── Designation Matching ──────────────────────────────────────────────────────
DESIGNATION_SIMILARITY_THRESHOLD=0.92     # 0.0 – 1.0 cosine similarity cutoff

# ── iGOT KB API ───────────────────────────────────────────────────────────────
KB_BASE_URL="https://<kb-host>"
KB_AUTH_TOKEN="Bearer <token>"

# ── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY="<random-secret-key>"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440          # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Document Storage ──────────────────────────────────────────────────────────
DOCUMENT_STORAGE_TYPE=gcp                 # local | gcp
GCP_STORAGE_BUCKET=<bucket-name>
GCP_STORAGE_CREDENTIALS=".creds/<storage-service-account>.json"

# ── Notifications ─────────────────────────────────────────────────────────────
ENABLE_EMAIL_NOTIFICATION=False
NOTIFICATION_BASE_URL="https://<notification-service-host>"
SPV_PORTAL_URL="https://<spv-portal-host>"
MDO_PORTAL_URL="https://<mdo-portal-host>"

# ── Bhashini Translation ──────────────────────────────────────────────────────
BHASHINI_USER_ID=<bhashini-user-id>
BHASHINI_API_KEY=<bhashini-api-key>
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_CONFIG_API_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_SUPPORTED_LANGUAGES=en,hi,te,kn,mr,ta,gu,ml,or,pa,bn,as
